# Copy to .env.local and fill in. Never commit real values.
# A MongoDB replica set connection string (transactions need one, architecture §8.2.8).
MONGODB_URI=
MONGODB_DB=bookbuddies
# Auth.js signing secret (generate with `npx auth secret`).
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# BookBuddies privacy notice supplied by the client. Required in production.
PRIVACY_NOTICE_URL=

# UC-PAR-onboarding. The app's own origin (links in emails; https makes the session
# cookie Secure). Required in production.
APP_URL=http://localhost:3000
# SMTP: Mailpit (smtp://localhost:1025) is the default outside production. In
# production, Resend's SMTP interface, with the API key as the password; set it only
# in Vercel's production environment. Without it, production sends no email.
SMTP_URL=
# The sender, on a domain verified in Resend. Required in production.
MAIL_FROM=
# Bearer secret for the daily cleanup cron (at least 32 characters). Unset refuses every call.
CRON_SECRET=
# Days to confirm consent before an unconfirmed account is deleted (placeholder, OI-22).
CONSENT_CONFIRMATION_DAYS=14
# The consent method; only email-plus is accepted for V1 (OI-21).
CONSENT_METHOD=email-plus
