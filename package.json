{
  "name": "book-buddies",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format:check": "prettier --check src tests scripts .github/workflows package.json tsconfig*.json *.config.ts eslint.config.js .prettierrc.json",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "test": "vitest run",
    "dev": "next dev",
    "demo": "node scripts/demo.mjs",
    "start": "next start",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:infrastructure": "vitest run --project infrastructure",
    "test:demo": "node scripts/check-demo.mjs",
    "test:e2e": "node --conditions=react-server node_modules/@playwright/test/cli.js test",
    "db:setup": "node --env-file-if-exists=.env.local --conditions=react-server scripts/ensure-indexes.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "mongodb-memory-server": "11.3.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@auth/mongodb-adapter": "3.11.3",
    "mongodb": "6.21.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  }
}
