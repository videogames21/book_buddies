{
  "name": "book-buddies",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "format:check": "prettier --check src .github/workflows package.json tsconfig.json tsconfig.build.json eslint.config.js .prettierrc.json",
